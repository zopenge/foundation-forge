{
  "name": "@openge/forge-workspace-checks-pnpm",
  "version": "0.1.0-rc.1",
  "description": "pnpm workspace checks command-line assembly and integration facade",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "bin": { "forge-workspace-checks": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "sideEffects": false,
  "engines": { "node": ">=22.14.0" },
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zopenge/foundation-forge.git",
    "directory": "packages/workspace-checks-pnpm"
  },
  "homepage": "https://github.com/zopenge/foundation-forge#readme",
  "bugs": { "url": "https://github.com/zopenge/foundation-forge/issues" },
  "dependencies": {
    "@openge/forge-workspace-checks": "workspace:^",
    "@openge/forge-workspace-pnpm": "workspace:^"
  }
}
