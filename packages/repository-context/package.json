{
  "name": "@openge/forge-repository-context",
  "version": "1.0.2",
  "description": "Deterministic repository context planning and validation primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/typescript": {
      "types": "./dist/adapters/typescript.d.ts",
      "browser": null,
      "import": "./dist/adapters/typescript.js"
    },
    "./adapters/cpp": {
      "types": "./dist/adapters/cpp.d.ts",
      "browser": null,
      "import": "./dist/adapters/cpp.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "browser": null,
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "forge-repository-context": "./dist/node/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zopenge/foundation-forge.git",
    "directory": "packages/repository-context"
  },
  "homepage": "https://github.com/zopenge/foundation-forge#readme",
  "bugs": {
    "url": "https://github.com/zopenge/foundation-forge/issues"
  },
  "dependencies": {
    "@openge/forge-generated-artifacts": "workspace:0.1.1",
    "typescript": "6.0.3"
  }
}
