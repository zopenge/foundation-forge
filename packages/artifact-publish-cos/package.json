{
  "name": "@openge/forge-artifact-publish-cos",
  "version": "0.1.0-rc.0",
  "description": "Explicit Tencent COS Provider for bounded immutable artifact publication",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "browser": null, "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "sideEffects": false,
  "engines": { "node": ">=22.14.0" },
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zopenge/foundation-forge.git",
    "directory": "packages/artifact-publish-cos"
  },
  "homepage": "https://github.com/zopenge/foundation-forge#readme",
  "bugs": { "url": "https://github.com/zopenge/foundation-forge/issues" },
  "dependencies": {
    "@openge/forge-artifact-publish": "workspace:0.1.0-rc.0",
    "@openge/forge-path-safety": "workspace:0.1.1",
    "cos-fast-xml-parser": "1.0.0",
    "cos-nodejs-sdk-v5": "3.0.0"
  }
}
