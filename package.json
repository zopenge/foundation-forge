{
  "name": "foundation-forge",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-neutral TypeScript foundation libraries for reusable cross-platform capabilities",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zopenge/foundation-forge.git"
  },
  "homepage": "https://github.com/zopenge/foundation-forge#readme",
  "bugs": {
    "url": "https://github.com/zopenge/foundation-forge/issues"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm run build && pnpm run typecheck:built",
    "typecheck:built": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "test:scripts": "node ./scripts/run-script-tests.mjs",
    "ab:eval": "node ./scripts/ab-eval.mjs",
    "test:coverage": "node ./scripts/run-workspace-coverage-batch.mjs",
    "packages:check-cycles": "pnpm --filter @openge/forge-workspace-checks-pnpm... run build && pnpm run packages:check-cycles:built",
    "packages:check-cycles:built": "node ./packages/workspace-checks-pnpm/dist/cli.js --check package-cycles",
    "pack:check": "node ./scripts/verify-packages.mjs",
    "check": "node ./scripts/check-runner.mjs --quick",
    "check:full": "node ./scripts/check-runner.mjs --full",
    "check:serial": "node ./scripts/check-runner.mjs --full --serial",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile --ignore-scripts",
    "release:bootstrap": "pnpm run check:full && node ./scripts/bootstrap-publish.mjs",
    "release:configure-trusted-publishers": "pnpm run check:full && node ./scripts/configure-trusted-publishers.mjs",
    "release:dispatch-next": "pnpm run check:full && node ./scripts/dispatch-release.mjs",
    "release:next": "pnpm run check:full && node ./scripts/publish-if-needed.mjs --tag next",
    "release:request-next": "pnpm run check:full && node ./scripts/request-next-release.mjs",
    "release:status": "node ./scripts/release-status.mjs",
    "release:verify": "node ./scripts/verify-release.mjs",
    "release:resume": "node ./scripts/resume-release.mjs",
    "release": "pnpm run check:full && node ./scripts/publish-if-needed.mjs",
    "check:quick": "node ./scripts/check-runner.mjs --quick",
    "check:full:run": "node ./scripts/check-full.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  }
}
